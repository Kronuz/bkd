# bkd: prune by cell boxes.
# Render: d2 docs/bkd.d2 docs/bkd.svg
vars: { d2-config: { layout-engine: elk; theme-id: 302; sketch: true; pad: 24; theme-overrides: { B1: "#8C7B7E"; B2: "#C25B73"; N2: "#C25B73" } } }
style.fill: transparent

direction: down
q: "query box" {shape: oval}
root: "root cell" {width: 240}
a: "cell A\noutside → skip" {style.stroke-dash: 3; width: 240}
b: "cell B\ninside → report all" {style.fill: "#e6f4ea"; width: 240}
c: "cell C\ncrosses the edge" {width: 240}
leaf: "leaf (≤512 points)\ncompare each point" {shape: stored_data; style.fill: "#F4F1EA"; width: 240}
q -> root
root -> a
root -> b
root -> c
c -> leaf
